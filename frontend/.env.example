# Frontend environment. Copy to `.env.local` and adjust for your host.
#
#   cp frontend/.env.example frontend/.env.local
#
# `.env.local` is gitignored: real values never enter the repository.

# ---------------------------------------------------------------- workbench
# Where the local API listens. Must stay on this host — the platform refuses
# a non-loopback inference endpoint, and the sovereignty monitor records any
# connection that leaves the machine.
WORKBENCH_API_URL=http://127.0.0.1:8000


# ----------------------------------------------------------------- firebase
# OPTIONAL, AND OFF BY DEFAULT.
#
# Firebase authentication contacts Google servers. On an air-gapped
# deployment those calls cannot succeed, and on a connected one they would
# contradict the platform's central claim and be recorded as egress by its own
# sovereignty monitor.
#
# The workbench therefore authenticates locally (PBKDF2, users defined in
# policies/access-control.yaml) and works with no Firebase configuration at
# all. Enable this only for a public demonstration build that is not handling
# confidential material.
NEXT_PUBLIC_FIREBASE_ENABLED=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics is deliberately absent: it reports usage to Google continuously,
# which is precisely the behaviour this platform exists to prevent.
