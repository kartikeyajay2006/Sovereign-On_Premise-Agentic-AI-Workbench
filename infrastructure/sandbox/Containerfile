# AEGIS sandbox image: the interpreter and the analysis libraries generated
# code may import, and nothing else it needs.
#
# Built once, on a connected machine or from a mirrored base image, and
# carried into the air-gapped host. The sandbox runs it with `--pull never`,
# so a missing image is reported by the startup probe, never fetched.
#
#   infrastructure/sandbox/build.sh            # podman (default)
#   RUNTIME=docker infrastructure/sandbox/build.sh
#
# Library versions are pinned to requirements.txt so a program behaves the
# same in the container as in the subprocess fallback. matplotlib is on the
# sandbox import allow-list but is not in requirements.txt, so it is not
# installed here either; an import of it fails in both runtimes alike.
FROM docker.io/library/python:3.11-slim-bookworm

RUN pip install --no-cache-dir \
        numpy==2.2.1 \
        pandas==2.2.3 \
        openpyxl==3.1.5 \
 && rm -rf /root/.cache

# Generated analysis code needs no shell, no package manager and no network
# tools. Removing them means an escape from the interpreter finds none of
# them, and os.system has nothing to run.
RUN rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg /usr/bin/wget /usr/bin/curl \
          /usr/bin/perl /bin/bash /bin/dash /bin/sh

# The sandbox always passes --user explicitly; this default is so that a
# container started from the image by hand is not root either.
USER 65534:65534
WORKDIR /workspace
ENTRYPOINT []
CMD ["python", "--version"]
